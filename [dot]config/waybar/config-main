{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 36,

    "modules-left": [
        "custom/paw",
        "hyprland/workspaces",
        "custom/new-workspace"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "temperature",
        "cpu",
        "memory",
        "pulseaudio",
        "bluetooth",
        "tray",
        "custom/power"
    ],

    "custom/paw": {
        "format": " ",
        "tooltip": false,
        "interval": "once",
        "on-click": "pkill fuzzel || fuzzel"
    },

    "custom/new-workspace": {
        "format": "+",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },

    "clock": {
        "format": "󰥔 {:%I:%M %p %a %d %b}",
        "on-click": "toggle-float calcurse-float 'kitty --class calcurse-float -e calcurse'",
        "tooltip": false,
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "format": "󰔏 {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "󰸁 {temperatureC}°C"
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"],
            "headphone": "󰋋",
            "headset": "󰋎"
        },
        "on-click": "toggle-float wiremix-float 'kitty --class wiremix-float -e wiremix'",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 {ipaddr}/{cidr}",
        "format-disconnected": "󰖪 Offline",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "bluetooth": {
            "format": "󰂯 {status}",
            "format-disabled": "󰂲 Off",
            "format-connected": "󰂱 {num_connections}",
            "tooltip-format": "{controller_alias}\t{controller_address}",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
            "on-click": "toggle-float bluetui-float 'kitty --class bluetui-float -e bluetui'",
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 4,
        "show-passive-items": true
    }
}
}