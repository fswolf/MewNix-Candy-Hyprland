include=~/.config/mako/mewnix-colors.conf
# ============================================================
# MAKO — Purple / Pink Waybar Theme
# ============================================================

# --- Global ---
font=JetBrainsMono Nerd Font 11


width=380
height=100

padding=12
margin=4
outer-margin=4

border-size=2
border-radius=14

anchor=bottom-right

default-timeout=8000
max-visible=4

icons=1
icon-location=left
max-icon-size=42
icon-path=/usr/share/icons/Adwaita:/usr/share/icons/hicolor:/usr/share/icons/breeze:/usr/share/icons/breeze-dark:/usr/share/pixmaps

markup=1
actions=1

# Keep newest notifications at the top
sort=-time

# Progress bar


# ============================================================
# NORMAL
# ============================================================

[urgency=normal]
border-size=2


# ============================================================
# LOW
# ============================================================

[urgency=low]
border-size=1


# ============================================================
# CRITICAL
# ============================================================

[urgency=critical]
background-color=#241522f8
text-color=#ffffff

border-color=#f472b6
border-size=3
border-radius=14

default-timeout=0

progress-color=over #f472b6
