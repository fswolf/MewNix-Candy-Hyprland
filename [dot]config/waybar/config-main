{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 28,

    "modules-left": [
        "custom/paw",
        "hyprland/workspaces",
        "custom/new-workspace"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "temperature",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "bluetooth",
        "tray",
        "custom/power"
    ],

    "custom/paw": {
        "format": " ",
        "tooltip": false,
        "interval": "once",
        "on-click": "pkill fuzzel || fuzzel"
    },

    "custom/new-workspace": {
        "format": "+",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },

    "clock": {
        "format": "{:%I:%M %p %a %d %b}",
        "on-click": "toggle-float calcurse-float 'kitty --class calcurse-float -e calcurse'",
        "tooltip": false,
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "format": "{temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C"
    },

    "cpu": {
        "interval": 2,
        "format": "{usage}%"
    },

    "memory": {
        "interval": 2,
        "format": "{percentage}%"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "Muted",
        "on-click": "toggle-float wiremix-float 'kitty --class wiremix-float -e wiremix'",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "tooltip": false
    },

    "network": {
        "interval": 5,
        "format": "{ifname}",
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "LAN",
        "format-linked": "Link",
        "format-disconnected": "Offline",
        "format-disabled": "Off",
        "tooltip-format": "{ifname}: {ipaddr}",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\n{ifname}: {ipaddr}",
        "tooltip-format-ethernet": "Ethernet\n{ifname}: {ipaddr}",
        "tooltip-format-disconnected": "Network disconnected",
        "tooltip-format-disabled": "Wi-Fi disabled"
    },

    "bluetooth": {
            "format": "Off",
            "format-on": "On",
            "format-off": "Off",
            "format-no-controller": "N/A",
            "format-disabled": "Off",
            "format-connected": "{num_connections}",
            "tooltip-format": "Bluetooth",
            "tooltip-format-on": "Bluetooth on — no devices connected",
            "tooltip-format-off": "Bluetooth off",
            "tooltip-format-disabled": "Bluetooth disabled",
            "tooltip-format-no-controller": "No Bluetooth adapter available",
            "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}",
            "on-click": "toggle-float bluetui-float 'kitty --class bluetui-float -e bluetui'",
    },

    "custom/power": {
        "format": " ",
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 4,
        "show-passive-items": true
    }
}
